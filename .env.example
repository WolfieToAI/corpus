# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Operator key for the /admin routes (create tenants and their API keys). Use a long random value.
ADMIN_API_KEY=
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# LLM for answer generation: any OpenAI-compatible endpoint (hosted or self-hosted).
# Without it, /search works but /chat returns 503.
LLM_PROVIDER=openai-compatible   # extractive: offline answers quoting the best source
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Database (overridden by docker-compose for the containers).
DATABASE_URL=postgresql+asyncpg://corpus:corpus@localhost:5432/corpus

# Embeddings: fastembed (local, multilingual, default) | voyage | hash (tests/demo only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# For Voyage: EMBEDDING_PROVIDER=voyage, EMBEDDING_MODEL=voyage-3.5, EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# Scanned PDFs: auto uses Tesseract when installed (it is in the Docker image) | tesseract | off
OCR=auto
OCR_LANGUAGES=eng+fra+deu

# Retrieval quality (see docs/EVALUATION.md for the measured trade-offs)
RERANKER=none                 # cross-encoder: better top results, ~1 s CPU per query
QUERY_REWRITING=true          # rewrite follow-up questions before retrieval (needs the LLM API key)

# Workers
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=300
